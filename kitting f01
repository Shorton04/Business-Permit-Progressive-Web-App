FORM validate_selection.
  IF s_aufnr[] IS INITIAL AND s_iwerk[] IS INITIAL.
    MESSAGE e001.
  ENDIF.
ENDFORM.
*---------------------------------------------------------------------*
* FORM: fetch_orders
*---------------------------------------------------------------------*
FORM fetch_orders.
  TYPES: BEGIN OF ty_afko_buf,
           aufnr TYPE afko-aufnr,
           rsnum TYPE afko-rsnum,
           gltrp TYPE afko-gltrp,
         END OF ty_afko_buf.
  DATA: lsr_orders   TYPE REF TO data,
        lv_count     TYPE i,
        lt_afko_buf  TYPE STANDARD TABLE OF ty_afko_buf.
  FIELD-SYMBOLS: <lt_result> TYPE STANDARD TABLE.
  "-----------------------------------------------------------
  " Clear any previous runtime info and IW39 memory IDs
  "-----------------------------------------------------------
  cl_salv_bs_runtime_info=>clear_all( ).
  FREE MEMORY ID 'RIAUFK20'.
  FREE MEMORY ID 'G_VARIANT_SAVE'.
  EXPORT no_list_display = abap_true  TO MEMORY ID 'RIAUFK20'.
  EXPORT g_variant_save  = abap_true  TO MEMORY ID 'G_VARIANT_SAVE'.
  cl_salv_bs_runtime_info=>set(
    EXPORTING
      display  = abap_false
      metadata = abap_false
      data     = abap_true ).
  SUBMIT riaufk20
      WITH dy_iar = 'X'
      WITH aufnr  IN s_aufnr
      WITH auart  IN s_auart
      WITH iwerk  IN s_iwerk
      WITH erdat  IN s_erdat
      WITH stai1  IN s_statin
      WITH stae1  IN s_statex
      WITH gstrp  IN s_gstrp
      WITH gltrp  IN s_gltrp
      WITH datuv  EQ '00000000'
      WITH datub  EQ '00000000'
      AND RETURN.
  TRY.
      cl_salv_bs_runtime_info=>get_data_ref( IMPORTING r_data = lsr_orders ).
      ASSIGN lsr_orders->* TO <lt_result>.
    CATCH cx_salv_bs_sc_runtime_info.
      MESSAGE e000(zmsg_a2r) WITH 'Unable to retrieve IW39 data'(m01).
      RETURN.
  ENDTRY.
  cl_salv_bs_runtime_info=>clear_all( ).
  FREE MEMORY ID 'RIAUFK20'.
  FREE MEMORY ID 'G_VARIANT_SAVE'.
  IF <lt_result> IS ASSIGNED AND <lt_result> IS NOT INITIAL.
    MOVE-CORRESPONDING <lt_result>[] TO gt_orders[].
  ELSE.
    MESSAGE s006(za2r_kcmpmsg).
    STOP.
  ENDIF.
  "-----------------------------------------------------------
  " Filter only released orders (IPHAS = 2)
  "-----------------------------------------------------------
  DELETE gt_orders WHERE iphas NE '2'.
  IF gt_orders IS INITIAL.
    MESSAGE e000(zmsg_a2r) WITH 'User does not have authorization to update.'(m02) DISPLAY LIKE 'E'.
    LEAVE LIST-PROCESSING.
  ENDIF.
  "-----------------------------------------------------------
  " Bulk fetch RSNUM and GLTRP from AFKO once (AUFNR is PK)
  "-----------------------------------------------------------
  SELECT aufnr, rsnum, gltrp
    FROM afko
    FOR ALL ENTRIES IN @gt_orders
    WHERE aufnr = @gt_orders-aufnr
    INTO TABLE @lt_afko_buf.
  SORT lt_afko_buf BY aufnr.
  "-----------------------------------------------------------
  " Fill RSNUM and missing GLTRP from buffer
  "-----------------------------------------------------------
  LOOP AT gt_orders ASSIGNING FIELD-SYMBOL(<fs_order>).
    READ TABLE lt_afko_buf
      ASSIGNING FIELD-SYMBOL(<ls_afko>)
      WITH KEY aufnr = <fs_order>-aufnr BINARY SEARCH.
    IF sy-subrc = 0.
<fs_order>-rsnum = <ls_afko>-rsnum.
      IF <fs_order>-gltrp IS INITIAL.
<fs_order>-gltrp = <ls_afko>-gltrp.
      ENDIF.
    ELSE.
      CLEAR <fs_order>-rsnum.
    ENDIF.
  ENDLOOP.
  DESCRIBE TABLE gt_orders LINES lv_count.
  IF lv_count > 0.
    MESSAGE s021 WITH lv_count.
  ELSE.
    MESSAGE e000(zmsg_a2r) WITH 'User does not have authorization to update.'(m02) DISPLAY LIKE 'E'.
    LEAVE LIST-PROCESSING.
  ENDIF.
ENDFORM.

*---------------------------------------------------------------------*
* FORM: filter has components
*---------------------------------------------------------------------*
FORM filter_has_components.
  TYPES: BEGIN OF ty_resb,
           rsnum TYPE resb-rsnum,
           postp TYPE resb-postp,
           enmng TYPE resb-enmng,
           bdmng TYPE resb-bdmng,
         END OF ty_resb,
         BEGIN OF ty_afko,
           aufnr TYPE afko-aufnr,
           rsnum TYPE afko-rsnum,
         END OF ty_afko,
         BEGIN OF ty_jest,
           objnr TYPE jest-objnr,
         END OF ty_jest,
         BEGIN OF ty_aufnr,
           aufnr TYPE aufk-aufnr,
         END OF ty_aufnr,
         BEGIN OF ty_rsnum,
           rsnum TYPE resb-rsnum,
         END OF ty_rsnum.
  DATA: lt_resb_buf     TYPE STANDARD TABLE OF ty_resb,
        lt_resb_curr    TYPE STANDARD TABLE OF ty_resb,
        lt_afko_buf     TYPE STANDARD TABLE OF ty_afko,
        lt_jest_buf     TYPE STANDARD TABLE OF ty_jest,
        lt_aufnr_keys   TYPE STANDARD TABLE OF ty_aufnr,
        lt_rsnum_keys   TYPE STANDARD TABLE OF ty_rsnum,
        lt_keep         TYPE TABLE OF lty_order,
        ls_order        TYPE lty_order,
        ls_resb         TYPE ty_resb,
        lv_rsnum        TYPE rsnum,
        lv_kcmp_active  TYPE abap_bool,
        lv_l_complete   TYPE abap_bool,
        lv_n_complete   TYPE abap_bool,
        lv_l_incomplete TYPE abap_bool,
        lv_n_incomplete TYPE abap_bool,
        lv_has_l        TYPE abap_bool,
        lv_has_n        TYPE abap_bool.
  IF gt_orders IS INITIAL.
    RETURN.
  ENDIF.
  "===============================================================
  " PRE-FETCH 1: Resolve missing RSNUMs via AFKO (AUFNR is PK)
  "===============================================================
  lt_aufnr_keys = VALUE #( FOR <fs> IN gt_orders
                           WHERE ( rsnum IS INITIAL )
                           ( aufnr = <fs>-aufnr ) ).
  IF lt_aufnr_keys IS NOT INITIAL.
    SELECT aufnr, rsnum
      FROM afko
      FOR ALL ENTRIES IN @lt_aufnr_keys
      WHERE aufnr = @lt_aufnr_keys-aufnr
      INTO TABLE @lt_afko_buf.
    SORT lt_afko_buf BY aufnr.
  ENDIF.
  "===============================================================
  " Build full RSNUM key list (existing + resolved)
  "===============================================================
  LOOP AT gt_orders ASSIGNING FIELD-SYMBOL(<fs_o>).
    IF <fs_o>-rsnum IS NOT INITIAL.
      APPEND VALUE #( rsnum = <fs_o>-rsnum ) TO lt_rsnum_keys.
    ELSE.
      READ TABLE lt_afko_buf ASSIGNING FIELD-SYMBOL(<fs_afko>)
        WITH KEY aufnr = <fs_o>-aufnr BINARY SEARCH.
      IF sy-subrc = 0 AND <fs_afko>-rsnum IS NOT INITIAL.
        APPEND VALUE #( rsnum = <fs_afko>-rsnum ) TO lt_rsnum_keys.
      ENDIF.
    ENDIF.
  ENDLOOP.
  SORT lt_rsnum_keys BY rsnum.
  DELETE ADJACENT DUPLICATES FROM lt_rsnum_keys COMPARING rsnum.
  "===============================================================
  " PRE-FETCH 2: All RESB components by RSNUM (uses HDB primary key)
  "===============================================================
  IF lt_rsnum_keys IS NOT INITIAL.
    SELECT rsnum, postp, enmng, bdmng
      FROM resb
      FOR ALL ENTRIES IN @lt_rsnum_keys
      WHERE rsnum = @lt_rsnum_keys-rsnum
        AND xloek = @space
      INTO TABLE @lt_resb_buf.
    SORT lt_resb_buf BY rsnum.
  ENDIF.
  "===============================================================
  " PRE-FETCH 3: Active KCMP statuses
  "===============================================================
  SELECT objnr
    FROM jest
    FOR ALL ENTRIES IN @gt_orders
    WHERE objnr = @gt_orders-objnr
      AND inact = @space
      AND stat  = @gv_estat
    INTO TABLE @lt_jest_buf.
  SORT lt_jest_buf BY objnr.
  "===============================================================
  " MAIN LOOP - no DB ops inside
  "===============================================================
  LOOP AT gt_orders INTO ls_order.
    CLEAR: lt_resb_curr, lv_rsnum, lv_kcmp_active,
           lv_l_complete, lv_n_complete,
           lv_l_incomplete, lv_n_incomplete,
           lv_has_l, lv_has_n.
    "-------------------------------------------------------------
    " Resolve RSNUM (from order or from AFKO buffer)
    "-------------------------------------------------------------
    IF ls_order-rsnum IS NOT INITIAL.
      lv_rsnum = ls_order-rsnum.
    ELSE.
      READ TABLE lt_afko_buf ASSIGNING <fs_afko>
        WITH KEY aufnr = ls_order-aufnr BINARY SEARCH.
      IF sy-subrc = 0.
        lv_rsnum = <fs_afko>-rsnum.
      ENDIF.
    ENDIF.
    IF lv_rsnum IS INITIAL.
      CONTINUE.
    ENDIF.
    "-------------------------------------------------------------
    " Get RESB rows for this RSNUM from buffer
    "-------------------------------------------------------------
    LOOP AT lt_resb_buf INTO ls_resb
         WHERE rsnum = lv_rsnum.
      APPEND ls_resb TO lt_resb_curr.
    ENDLOOP.
    IF lt_resb_curr IS INITIAL.
      CONTINUE. " Skip orders with no components
    ENDIF.
    "-------------------------------------------------------------
    " KCMP active check (from JEST buffer)
    "-------------------------------------------------------------
    READ TABLE lt_jest_buf TRANSPORTING NO FIELDS
      WITH KEY objnr = ls_order-objnr BINARY SEARCH.
    IF sy-subrc = 0.
      lv_kcmp_active = abap_true.
    ENDIF.
    "-------------------------------------------------------------
    " Determine component completeness
    "-------------------------------------------------------------
    LOOP AT lt_resb_curr INTO ls_resb.
      CASE ls_resb-postp.
        WHEN gc_postp_l.
          lv_has_l = abap_true.
          IF ls_resb-enmng < ls_resb-bdmng.
            lv_l_incomplete = abap_true.
          ELSE.
            lv_l_complete = abap_true.
          ENDIF.
        WHEN gc_postp_n.
          lv_has_n = abap_true.
          IF ls_resb-enmng < ls_resb-bdmng.
            lv_n_incomplete = abap_true.
          ELSE.
            lv_n_complete = abap_true.
          ENDIF.
      ENDCASE.
    ENDLOOP.
    "-------------------------------------------------------------
    " Ignore if no L and no N components present
    "-------------------------------------------------------------
    IF lv_has_l IS INITIAL AND lv_has_n IS INITIAL.
      CONTINUE.
    ENDIF.
*---------------------------------------------------------------------*
* HANDLE SET STATUS
*---------------------------------------------------------------------*
    IF p_set = abap_true.
      IF lv_kcmp_active = abap_true.
        CONTINUE.
      ENDIF.
      " BOTH L AND N EXIST
      IF lv_has_l = abap_true AND lv_has_n = abap_true.
        IF lv_l_complete = abap_true AND lv_n_complete = abap_true.
          APPEND ls_order TO lt_keep.
        ELSEIF lv_l_complete = abap_true AND lv_n_incomplete = abap_true.
          IF ( p_reserv = abap_true AND p_preq = abap_false )
             OR ( p_reserv IS INITIAL AND p_preq IS INITIAL ).
            APPEND ls_order TO lt_keep.
          ENDIF.
        ELSEIF lv_l_incomplete = abap_true AND lv_n_complete = abap_true.
          IF ( p_reserv = abap_false AND p_preq = abap_true )
             OR ( p_reserv IS INITIAL AND p_preq IS INITIAL ).
            APPEND ls_order TO lt_keep.
          ENDIF.
        ELSEIF lv_l_incomplete = abap_true AND lv_n_incomplete = abap_true.
          IF p_reserv IS INITIAL AND p_preq IS INITIAL.
            APPEND ls_order TO lt_keep.
          ENDIF.
        ENDIF.
      " L ONLY
      ELSEIF lv_has_l = abap_true AND lv_has_n = abap_false.
        IF lv_l_complete = abap_true.
          IF ( p_reserv = abap_true )
             OR ( p_reserv IS INITIAL AND p_preq IS INITIAL ).
            APPEND ls_order TO lt_keep.
          ENDIF.
        ELSE.
          IF p_reserv IS INITIAL AND p_preq IS INITIAL.
            APPEND ls_order TO lt_keep.
          ENDIF.
        ENDIF.
      " N ONLY
      ELSEIF lv_has_l = abap_false AND lv_has_n = abap_true.
        IF lv_n_complete = abap_true.
          IF ( p_preq = abap_true )
             OR ( p_reserv IS INITIAL AND p_preq IS INITIAL ).
            APPEND ls_order TO lt_keep.
          ENDIF.
        ELSE.
          IF p_reserv IS INITIAL AND p_preq IS INITIAL.
            APPEND ls_order TO lt_keep.
          ENDIF.
        ENDIF.
      ENDIF.
      CONTINUE.
*---------------------------------------------------------------------*
* HANDLE RESET STATUS
*---------------------------------------------------------------------*
    ELSEIF p_reset = abap_true.
      IF lv_kcmp_active = abap_false.
        CONTINUE.
      ENDIF.
      " BOTH L AND N EXIST
      IF lv_has_l = abap_true AND lv_has_n = abap_true.
        IF lv_l_complete = abap_true AND lv_n_complete = abap_true.
          IF p_reserv IS INITIAL AND p_preq IS INITIAL.
            APPEND ls_order TO lt_keep.
          ENDIF.
        ELSEIF lv_l_complete = abap_true AND lv_n_incomplete = abap_true.
          IF ( p_reserv = abap_true AND p_preq = abap_true )
             OR ( p_preq = abap_true AND p_reserv IS INITIAL )
             OR ( p_reserv IS INITIAL AND p_preq IS INITIAL ).
            APPEND ls_order TO lt_keep.
          ENDIF.
        ELSEIF lv_l_incomplete = abap_true AND lv_n_complete = abap_true.
          IF ( p_reserv = abap_true AND p_preq = abap_true )
             OR ( p_preq IS INITIAL AND p_reserv = abap_true )
             OR ( p_reserv IS INITIAL AND p_preq IS INITIAL ).
            APPEND ls_order TO lt_keep.
          ENDIF.
        ELSEIF lv_l_incomplete = abap_true AND lv_n_incomplete = abap_true.
          APPEND ls_order TO lt_keep.
        ENDIF.
      " L ONLY
      ELSEIF lv_has_l = abap_true AND lv_has_n = abap_false.
        IF lv_l_complete = abap_true.
          IF p_reserv IS INITIAL AND p_preq IS INITIAL.
            APPEND ls_order TO lt_keep.
          ENDIF.
        ELSE.
          IF ( p_reserv = abap_true AND p_preq = abap_true )
             OR ( p_reserv = abap_true AND p_preq IS INITIAL )
             OR ( p_reserv IS INITIAL AND p_preq IS INITIAL ).
            APPEND ls_order TO lt_keep.
          ENDIF.
        ENDIF.
      " N ONLY
      ELSEIF lv_has_l = abap_false AND lv_has_n = abap_true.
        IF lv_n_complete = abap_true.
          IF p_reserv IS INITIAL AND p_preq IS INITIAL.
            APPEND ls_order TO lt_keep.
          ENDIF.
        ELSE.
          IF ( p_reserv = abap_true AND p_preq = abap_true )
             OR ( p_preq = abap_true AND p_reserv IS INITIAL )
             OR ( p_reserv IS INITIAL AND p_preq IS INITIAL ).
            APPEND ls_order TO lt_keep.
          ENDIF.
        ENDIF.
      ENDIF.
      CONTINUE.
    ENDIF.
  ENDLOOP.
  gt_orders = lt_keep.
ENDFORM.

*---------------------------------------------------------------------*
* FORM: evaluate_kitting
*---------------------------------------------------------------------*
FORM evaluate_kitting.
  TYPES: BEGIN OF ty_jest,
           objnr TYPE jest-objnr,
         END OF ty_jest.
  DATA: lv_msg         TYPE string,
        lv_kcmp_active TYPE abap_bool,
        lt_jest_buf    TYPE STANDARD TABLE OF ty_jest.
  "---------------------------------------------------------------
  " Pre-fetch all active KCMP statuses for orders in scope
  "---------------------------------------------------------------
  IF gt_orders IS NOT INITIAL.
    SELECT objnr
      FROM jest
      FOR ALL ENTRIES IN @gt_orders
      WHERE objnr = @gt_orders-objnr
        AND inact = @space
        AND stat  = @gv_estat
      INTO TABLE @lt_jest_buf.
    SORT lt_jest_buf BY objnr.
  ENDIF.
  "---------------------------------------------------------------
  " Loop over orders - only in-memory lookups inside the loop
  "---------------------------------------------------------------
  LOOP AT gt_orders INTO DATA(ls_order).
    CLEAR lv_kcmp_active.
    READ TABLE lt_jest_buf TRANSPORTING NO FIELDS
      WITH KEY objnr = ls_order-objnr BINARY SEARCH.
    IF sy-subrc = 0.
      lv_kcmp_active = abap_true.
    ENDIF.
    "-------------------------------------------------------------
    " Log only actionable entries (gt_orders already filtered)
    "-------------------------------------------------------------
    IF p_set = abap_true.
      " SET mode: these orders are complete and KCMP not active
      MESSAGE s016 WITH ls_order-aufnr INTO lv_msg.
      APPEND VALUE #(
        aufnr        = ls_order-aufnr
        auart        = ls_order-auart
        iwerk        = ls_order-iwerk
        erdat        = ls_order-erdat
        gstrp        = ls_order-gstrp
        gltrp        = ls_order-gltrp
        msgtxt       = lv_msg
        light        = gc_light_green_code
        kcmp_active  = COND #( WHEN lv_kcmp_active = abap_true THEN 'X' ELSE space )
      ) TO gt_log.
    ELSEIF p_reset = abap_true.
      " RESET mode: these orders are KCMP-active + incomplete
      MESSAGE s015 WITH ls_order-aufnr INTO lv_msg.
      APPEND VALUE #(
        aufnr        = ls_order-aufnr
        auart        = ls_order-auart
        iwerk        = ls_order-iwerk
        erdat        = ls_order-erdat
        gstrp        = ls_order-gstrp
        gltrp        = ls_order-gltrp
        msgtxt       = lv_msg
        light        = gc_light_green_code
        kcmp_active  = 'X'
      ) TO gt_log.
    ENDIF.
  ENDLOOP.
ENDFORM.

