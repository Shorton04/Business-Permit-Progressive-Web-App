*---------------------------------------------------------------------*
* FORM: release_locks
*---------------------------------------------------------------------*
"--------------------------------------------------------------------*
"& Form RELEASE_LOCKS
"--------------------------------------------------------------------*
"   Releases all enqueue locks related to an order.
"   All DB lookups are done in-memory via pre-fetched buffers
"   to comply with ATC checks (no DB ops inside loops across
"   modularization units).
"--------------------------------------------------------------------*
"--------------------------------------------------------------------*
"& Form RELEASE_LOCKS
"--------------------------------------------------------------------*
"   Releases all enqueue locks related to an order.
"   All DB lookups are done in-memory via pre-fetched buffers
"   to comply with ATC checks (no DB ops inside loops across
"   modularization units).
"--------------------------------------------------------------------*
FORM release_locks
       USING p_aufnr   TYPE aufk-aufnr
             pt_afko   TYPE tt_afko
             pt_qals   TYPE tt_qals
             pt_qmel   TYPE tt_qmel
             pt_tfdir  TYPE tt_funcname.
  DATA: lv_aufnr    TYPE aufk-aufnr,
        lv_rsnum    TYPE afko-rsnum,
        lv_prueflos TYPE qals-prueflos,
        lv_qmnum    TYPE qmel-qmnum,
        lv_objnr    TYPE jest-objnr,
        lt_fms      TYPE tt_funcname,
        lv_fm       TYPE funcname.
  FIELD-SYMBOLS: <ls_afko> TYPE ty_afko,
<ls_qals> TYPE ty_qals,
<ls_qmel> TYPE ty_qmel.
  "------------------------------------------------------------------*
  " Convert AUFNR to internal format
  "------------------------------------------------------------------*
  CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
    EXPORTING
      input  = p_aufnr
    IMPORTING
      output = lv_aufnr.
  "------------------------------------------------------------------*
  " Resolve RSNUM, PRUEFLOS, QMNUM from pre-fetched buffers
  "------------------------------------------------------------------*
  READ TABLE pt_afko ASSIGNING <ls_afko>
    WITH KEY aufnr = lv_aufnr BINARY SEARCH.
  IF sy-subrc = 0.
    lv_rsnum = <ls_afko>-rsnum.
  ENDIF.
  READ TABLE pt_qals ASSIGNING <ls_qals>
    WITH KEY aufnr = lv_aufnr BINARY SEARCH.
  IF sy-subrc = 0.
    lv_prueflos = <ls_qals>-prueflos.
  ENDIF.
  READ TABLE pt_qmel ASSIGNING <ls_qmel>
    WITH KEY aufnr = lv_aufnr BINARY SEARCH.
  IF sy-subrc = 0.
    lv_qmnum = <ls_qmel>-qmnum.
  ENDIF.
  CONCATENATE 'OR' lv_aufnr INTO lv_objnr.
  "------------------------------------------------------------------*
  " Candidate DEQUEUE function modules
  "------------------------------------------------------------------*
  lt_fms = VALUE #(
    ( 'DEQUEUE_EAUFK' )
    ( 'DEQUEUE_EAFKO' )
    ( 'DEQUEUE_EAFVC' )
    ( 'DEQUEUE_EEQUI' )
    ( 'DEQUEUE_EIFLOT' )
    ( 'DEQUEUE_ERESB' )
    ( 'DEQUEUE_ERKPF' )
    ( 'DEQUEUE_EQALS' )
    ( 'DEQUEUE_EQMEL' )
  ).
  "------------------------------------------------------------------*
  " Release locks - only in-memory READ TABLE inside the loop
  "------------------------------------------------------------------*
  LOOP AT lt_fms INTO lv_fm.
    READ TABLE pt_tfdir TRANSPORTING NO FIELDS
      WITH KEY table_line = lv_fm BINARY SEARCH.
    IF sy-subrc <> 0.
      CONTINUE.
    ENDIF.
    TRY.
        CASE lv_fm.
          WHEN 'DEQUEUE_EAUFK' OR 'DEQUEUE_EAFKO'.
            CALL FUNCTION lv_fm EXPORTING aufnr = lv_aufnr.
          WHEN 'DEQUEUE_EAFVC'.
            CALL FUNCTION lv_fm EXPORTING objnr = lv_objnr.
          WHEN 'DEQUEUE_ERESB' OR 'DEQUEUE_ERKPF'.
            IF lv_rsnum IS NOT INITIAL.
              CALL FUNCTION lv_fm EXPORTING rsnum = lv_rsnum.
            ENDIF.
          WHEN 'DEQUEUE_EQALS'.
            IF lv_prueflos IS NOT INITIAL.
              CALL FUNCTION lv_fm EXPORTING prueflos = lv_prueflos.
            ENDIF.
          WHEN 'DEQUEUE_EQMEL'.
            IF lv_qmnum IS NOT INITIAL.
              CALL FUNCTION lv_fm EXPORTING qmnum = lv_qmnum.
            ENDIF.
        ENDCASE.
      ##CATCH_ALL
      CATCH cx_root.
        CONTINUE.
    ENDTRY.
  ENDLOOP.
  CALL FUNCTION 'DEQUEUE_ALL'.
ENDFORM.
