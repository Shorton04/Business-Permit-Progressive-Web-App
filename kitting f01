*---------------------------------------------------------------------*
* FORM: update_user_status
*---------------------------------------------------------------------*
"--------------------------------------------------------------------*
"& Form UPDATE_USER_STATUS
"--------------------------------------------------------------------*
FORM update_user_status.
  TYPES: BEGIN OF ty_aufk,
           aufnr TYPE aufk-aufnr,
           objnr TYPE aufk-objnr,
         END OF ty_aufk,
         BEGIN OF ty_jest_act,
           objnr TYPE jest-objnr,
         END OF ty_jest_act.
  DATA: lv_objnr        TYPE jest-objnr,
        lv_kcmp_active  TYPE abap_bool,
        lt_aufk_buf     TYPE STANDARD TABLE OF ty_aufk,
        lt_jest_buf     TYPE STANDARD TABLE OF ty_jest_act,
        lt_aufnr_keys   TYPE tt_aufnr,
        lt_objnr_keys   TYPE STANDARD TABLE OF aufk-objnr,
        lt_header       TYPE TABLE OF bapi_alm_order_headers_i,
        lt_status       TYPE TABLE OF bapi_alm_order_usrstat,
        lt_methods      TYPE TABLE OF bapi_alm_order_method,
        lt_return       TYPE TABLE OF bapiret2,
        ls_return       TYPE bapiret2.
  " Buffers needed by release_locks
  DATA: lt_afko_lock_buf  TYPE tt_afko,
        lt_qals_lock_buf  TYPE tt_qals,
        lt_qmel_lock_buf  TYPE tt_qmel,
        lt_tfdir_lock_buf TYPE tt_funcname.
  IF gt_log IS INITIAL.
    RETURN.
  ENDIF.
*--------------------------------------------------------------------*
* PRE-FETCH 1: AUFK -> OBJNR for all green-light orders
*--------------------------------------------------------------------*
  lt_aufnr_keys = VALUE #( FOR <fs_log> IN gt_log
                           WHERE ( light = 'G' )
                           ( <fs_log>-aufnr ) ).
  SORT lt_aufnr_keys.
  DELETE ADJACENT DUPLICATES FROM lt_aufnr_keys.
  IF lt_aufnr_keys IS NOT INITIAL.
    SELECT aufnr, objnr
      FROM aufk
      FOR ALL ENTRIES IN @lt_aufnr_keys
      WHERE aufnr = @lt_aufnr_keys-table_line
      INTO TABLE @lt_aufk_buf.
    SORT lt_aufk_buf BY aufnr.
  ENDIF.
*--------------------------------------------------------------------*
* PRE-FETCH 2: JEST active KCMP statuses
*--------------------------------------------------------------------*
  lt_objnr_keys = VALUE #( FOR <fs_aufk_b> IN lt_aufk_buf ( <fs_aufk_b>-objnr ) ).
  SORT lt_objnr_keys.
  DELETE ADJACENT DUPLICATES FROM lt_objnr_keys.
  IF lt_objnr_keys IS NOT INITIAL.
    SELECT objnr
      FROM jest
      FOR ALL ENTRIES IN @lt_objnr_keys
      WHERE objnr = @lt_objnr_keys-table_line
        AND inact = @space
        AND stat  = @gv_estat
      INTO TABLE @lt_jest_buf.
    SORT lt_jest_buf BY objnr.
  ENDIF.
*--------------------------------------------------------------------*
* PRE-FETCH 3: Buffers needed by release_locks (AFKO/QALS/QMEL/TFDIR)
*--------------------------------------------------------------------*
  PERFORM prefetch_release_lock_buffers
    USING    lt_aufnr_keys
    CHANGING lt_afko_lock_buf
             lt_qals_lock_buf
             lt_qmel_lock_buf
             lt_tfdir_lock_buf.
*--------------------------------------------------------------------*
* MAIN LOOP - no DB ops inside
*--------------------------------------------------------------------*
  LOOP AT gt_log INTO DATA(ls_log)
    WHERE light = 'G'.
    CLEAR: lv_objnr, lv_kcmp_active,
           lt_header, lt_status, lt_methods, lt_return, ls_return.
*--------------------------------------------------------------------*
* Recheck KCMP active status from buffers
*--------------------------------------------------------------------*
    READ TABLE lt_aufk_buf ASSIGNING FIELD-SYMBOL(<fs_aufk>)
      WITH KEY aufnr = ls_log-aufnr BINARY SEARCH.
    IF sy-subrc = 0.
      lv_objnr = <fs_aufk>-objnr.
      READ TABLE lt_jest_buf TRANSPORTING NO FIELDS
        WITH KEY objnr = lv_objnr BINARY SEARCH.
      lv_kcmp_active = xsdbool( sy-subrc = 0 ).
    ENDIF.
*--------------------------------------------------------------------*
* Validation
*--------------------------------------------------------------------*
    IF p_set = abap_true AND lv_kcmp_active = abap_true.
      MESSAGE ID gc_msgid TYPE 'I' NUMBER '018' WITH ls_log-aufnr INTO ls_log-msgtxt.
      ls_log-msgid = gc_msgid.
      ls_log-msgno = '018'.
      ls_log-msgtp = 'I'.
      ls_log-light = 'O'.
      MODIFY gt_log FROM ls_log.
      CONTINUE.
    ENDIF.
    IF p_reset = abap_true AND lv_kcmp_active = abap_false.
      MESSAGE ID gc_msgid TYPE 'I' NUMBER '019' WITH ls_log-aufnr INTO ls_log-msgtxt.
      ls_log-msgid = gc_msgid.
      ls_log-msgno = '019'.
      ls_log-msgtp = 'I'.
      ls_log-light = 'O'.
      MODIFY gt_log FROM ls_log.
      CONTINUE.
    ENDIF.
*--------------------------------------------------------------------*
* Authorization check
*--------------------------------------------------------------------*
    AUTHORITY-CHECK OBJECT 'I_IWERK' ID 'IWERK' FIELD ls_log-iwerk ID 'TCD' FIELD sy-tcode.
    IF sy-subrc <> 0.
      MESSAGE ID gc_msgid TYPE 'E' NUMBER '002' WITH ls_log-iwerk INTO ls_log-msgtxt.
      ls_log-msgid = gc_msgid.
      ls_log-msgno = '002'.
      ls_log-msgtp = 'E'.
      ls_log-light = 'R'.
      MODIFY gt_log FROM ls_log.
      CONTINUE.
    ENDIF.
*--------------------------------------------------------------------*
* Build BAPI input data
*--------------------------------------------------------------------*
    APPEND VALUE #( orderid = ls_log-aufnr ) TO lt_header.
    IF p_reset = abap_true.
      APPEND VALUE #( user_st_text = p_estat inactive = 'X' langu = p_spras ) TO lt_status.
    ELSE.
      APPEND VALUE #( user_st_text = p_estat langu = p_spras ) TO lt_status.
    ENDIF.
    APPEND VALUE #( refnumber = '00001' objecttype = 'HEADER'
                    method = 'CHANGE' objectkey = ls_log-aufnr ) TO lt_methods.
    APPEND VALUE #( refnumber = '00001' objecttype = 'USERSTATUS'
                    method = 'CHANGE' objectkey = ls_log-aufnr ) TO lt_methods.
    APPEND VALUE #( refnumber = '00003' objecttype = 'ORDER'
                    method = 'SAVE'   objectkey = ls_log-aufnr ) TO lt_methods.
*--------------------------------------------------------------------*
* Execute BAPI
*--------------------------------------------------------------------*
    CALL FUNCTION 'BAPI_ALM_ORDER_MAINTAIN'
      TABLES
        it_header     = lt_header
        it_methods    = lt_methods
        it_userstatus = lt_status
        return        = lt_return.
    READ TABLE lt_return INTO ls_return WITH KEY type = 'E'.
    IF sy-subrc = 0.
      " Error case
      ls_log-msgtxt = ls_return-message.
      ls_log-msgid  = ls_return-id.
      ls_log-msgno  = ls_return-number.
      ls_log-msgtp  = ls_return-type.
      ls_log-light  = 'R'.
      CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
    ELSE.
      " Success case
      IF p_reset = abap_true.
        MESSAGE ID gc_msgid TYPE 'I' NUMBER '004' WITH p_estat INTO ls_log-msgtxt.
        ls_log-msgid = gc_msgid.
        ls_log-msgno = '004'.
        ls_log-msgtp = 'I'.
        CLEAR ls_log-kcmp_active.
      ELSE.
        MESSAGE ID gc_msgid TYPE 'I' NUMBER '003' WITH p_estat INTO ls_log-msgtxt.
        ls_log-msgid = gc_msgid.
        ls_log-msgno = '003'.
        ls_log-msgtp = 'I'.
        ls_log-kcmp_active = 'X'.
      ENDIF.
      ls_log-light = 'G'.
      CALL FUNCTION 'BAPI_TRANSACTION_COMMIT' EXPORTING wait = 'X'.
    ENDIF.
*--------------------------------------------------------------------*
* Release locks (uses pre-fetched buffers - no DB ops)
*--------------------------------------------------------------------*
    PERFORM release_locks USING ls_log-aufnr
                                lt_afko_lock_buf
                                lt_qals_lock_buf
                                lt_qmel_lock_buf
                                lt_tfdir_lock_buf.
    MODIFY gt_log FROM ls_log.
  ENDLOOP.
ENDFORM.
"--------------------------------------------------------------------*
"& Form PREFETCH_RELEASE_LOCK_BUFFERS
"--------------------------------------------------------------------*
"   Bulk-fetch all data needed by release_locks once, so the FORM
"   itself has zero DB operations.
"--------------------------------------------------------------------*
FORM prefetch_release_lock_buffers
       USING    pt_aufnr_keys TYPE tt_aufnr
       CHANGING ct_afko       TYPE tt_afko
                ct_qals       TYPE tt_qals
                ct_qmel       TYPE tt_qmel
                ct_tfdir      TYPE tt_funcname.
  CLEAR: ct_afko, ct_qals, ct_qmel, ct_tfdir.
  IF pt_aufnr_keys IS NOT INITIAL.
    SELECT aufnr, rsnum
      FROM afko
      FOR ALL ENTRIES IN @pt_aufnr_keys
      WHERE aufnr = @pt_aufnr_keys-table_line
      INTO TABLE @ct_afko.
    SORT ct_afko BY aufnr.
    SELECT aufnr, prueflos
      FROM qals
      FOR ALL ENTRIES IN @pt_aufnr_keys
      WHERE aufnr = @pt_aufnr_keys-table_line
      INTO TABLE @ct_qals.
    SORT ct_qals BY aufnr.
    SELECT aufnr, qmnum
      FROM qmel
      FOR ALL ENTRIES IN @pt_aufnr_keys
      WHERE aufnr = @pt_aufnr_keys-table_line
      INTO TABLE @ct_qmel.
    SORT ct_qmel BY aufnr.
  ENDIF.
  DATA(lt_fm_check) = VALUE tt_funcname(
    ( 'DEQUEUE_EAUFK' ) ( 'DEQUEUE_EAFKO' ) ( 'DEQUEUE_EAFVC' )
    ( 'DEQUEUE_EEQUI' ) ( 'DEQUEUE_EIFLOT' ) ( 'DEQUEUE_ERESB' )
    ( 'DEQUEUE_ERKPF' ) ( 'DEQUEUE_EQALS' ) ( 'DEQUEUE_EQMEL' ) ).
  SELECT funcname
    FROM tfdir
    FOR ALL ENTRIES IN @lt_fm_check
    WHERE funcname = @lt_fm_check-table_line
    INTO TABLE @ct_tfdir.
  SORT ct_tfdir.
ENDFORM.
*---------------------------------------------------------------------*
