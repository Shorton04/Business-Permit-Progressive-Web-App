*---------------------------------------------------------------------*
* FORM: get_kcmp_status
*---------------------------------------------------------------------*
FORM get_kcmp_status.
  "Resolve ESTAT for the user status text (KCMP)
  SELECT j~estat
    INTO @gv_estat
    FROM tj30 AS j
    INNER JOIN tj30t AS t
      ON j~estat = t~estat
    UP TO 1 ROWS
   WHERE t~txt04 = @p_estat
     AND t~spras = @p_spras.
  ENDSELECT.
  IF sy-subrc <> 0 OR gv_estat IS INITIAL.
    MESSAGE e005 WITH p_estat p_spras.
  ENDIF.
ENDFORM.
